{
  "name": "luchelles-south-african-time-machine",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Luchelle's South African Time Machine \u2014 an interactive storybook history of South Africa for young readers.",
  "scripts": {
